# Copy this file to ".env" and fill in your own values.
# Never commit the real ".env" file.

# Bot identity
BOT_NAME=Baileys Bot
PREFIX=.
OWNER_NUMBER=254700000000
OWNER_NAME=Owner Name

# WhatsApp account that will run the bot (international format, digits only, no "+")
# If left empty the bot will ask you for it at startup.
PHONE_NUMBER=254700000000

# Authentication
USE_PAIRING_CODE=true
SESSION_DIR=auth

# Logging
LOG_LEVEL=info
LOG_PRETTY=false

# Storage
DATABASE_FILE=database/settings.json
TEMP_DIR=tmp

# Connection tuning (milliseconds)
CONNECT_TIMEOUT_MS=60000
DEFAULT_QUERY_TIMEOUT_MS=60000
KEEP_ALIVE_INTERVAL_MS=30000

# Media safety
MAX_MEDIA_MB=64
DOWNLOAD_TIMEOUT_MS=120000

# Rate limiting
RATE_LIMIT_WINDOW_MS=10000
RATE_LIMIT_MAX=8

# Gifted API (https://api.gifted.co.ke)
GIFTED_API_KEY=gifted
GIFTED_BASE_URL=https://api.gifted.co.ke

# azbry music API
AZBRY_BASE_URL=https://api.azbry.com

# VidsSave / AllDL API
VIDSSAVE_ENDPOINT=https://api.vidssave.com/api/contentsite_api/media/parse
VIDSSAVE_AUTH=20250901majwlqo
VIDSSAVE_DOMAIN=api-ak.vidssave.com
VIDSSAVE_ORIGIN=source
